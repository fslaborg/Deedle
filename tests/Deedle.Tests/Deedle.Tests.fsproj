<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Deedle\Deedle.fsproj" />
    <ProjectReference Include="..\..\src\Deedle.Parquet\Deedle.Parquet.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Common/FsUnit.fs">
      <Link>FsUnit.fs</Link>
    </Compile>
    <Compile Include="../Common/CsvTestData.fs">
      <Link>CsvTestData.fs</Link>
    </Compile>
    <Compile Include="../Common/ParquetTestData.fs">
      <Link>ParquetTestData.fs</Link>
    </Compile>
    <Compile Include="Common.fs" />
    <Compile Include="Vector.fs" />
    <Compile Include="MultiKey.fs" />
    <Compile Include="Deque.fs" />
    <Compile Include="Stats.fs" />
    <Compile Include="Series.fs" />
    <Compile Include="Frame.fs" />
    <Compile Include="LazySeries.fs" />
    <Compile Include="Ranges.fs" />
    <Compile Include="VirtualInstrumentation.fs" />
    <Compile Include="VirtualFrame.fs" />
    <Compile Include="VirtualVector.fs" />
    <Compile Include="VirtualIndex.fs" />
    <Compile Include="VirtualSeries.fs" />
    <Compile Include="VirtualLookupRange.fs" />
    <Compile Include="VirtualCsvSource.fs" />
    <Compile Include="VirtualParquetSource.fs" />
    <Compile Include="VirtualFrameDiagnostics.fs" />
    <Compile Include="VirtualPartitioned.fs" />
    <Compile Include="Formatting.fs" />
    <None Include="paket.references" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
