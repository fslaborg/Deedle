<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Deedle.Benchmarks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Common/FsUnit.fs">
      <Link>FsUnit.fs</Link>
    </Compile>
    <Compile Include="../Common/CsvTestData.fs">
      <Link>CsvTestData.fs</Link>
    </Compile>
    <Compile Include="../Common/ParquetTestData.fs">
      <Link>ParquetTestData.fs</Link>
    </Compile>
    <Compile Include="../Deedle.Tests/VirtualInstrumentation.fs">
      <Link>VirtualInstrumentation.fs</Link>
    </Compile>
    <Compile Include="Benchmarks.fs" />
    <Compile Include="VirtualBenchmarks.fs" />
    <Compile Include="RealSourceBenchmarks.fs" />
    <Compile Include="Program.fs" />
    <None Include="paket.references" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Deedle\Deedle.fsproj" />
    <ProjectReference Include="..\..\src\Deedle.Parquet\Deedle.Parquet.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Performance/data/titanic.csv">
      <Link>data/titanic.csv</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
